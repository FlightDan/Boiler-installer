schema_version: 1
kind: BoilerComponentDefinitions
definitions:
  battery:
    schema_version: 1
    kind: ComponentManifest
    version: 0.2.2
    name:
      en: "Battery 0.2.2: consistent charge and sleep sliders"
      zh: Battery 0.2.2：统一充电与待机滑块
    description:
      en: "Charge limit, three charging modes and seven sleep choices use consistent slider sections. Existing preferences are preserved until changed. Saving never initiates sleep. X2 charge controls remain disabled."
      zh: 充电上限、三档充电方式与七档待机统一使用滑块区块；调整前保留既有偏好，保存不会立即睡眠。X2 不启用充电控制。
    default: false
    optional: true
    requires: []
    conflicts: []
    files[7]{source,target,size,sha256,mode}:
      shared-adaptations/battery/000.bin,var/lib/oxp3-battery/battery_control.py,837,c53c91e39cf96f869bc5aec56338313087626edf2bc4466d1f31520e153f8d0e,420
