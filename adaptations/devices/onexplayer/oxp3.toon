schema_version: 1
kind: ModelInstallGuide
id: "guide:oxp3"
name: ONEXPLAYER 3
installable: false
guide: brands/onexplayer/oxp3/model.md
source_inventory: source-lock.json
source_revision:
  kind: github
  repository: FlightDan/OneXPlayer3-SteamOS
  commit: 72f864e0498c10366493c74608c5ffed62cc99ca
components[29]:
  - id: fingerprint-unlock
    name: 指纹解锁（实验功能）
    recommendation: optional
    default: true
    dependencies[1]: decky
    sources[3]: common/fingerprint/bridge/main.py,common/fingerprint/runtime-profile/profile.json,brands/onexplayer/oxp3/current/fingerprint/69-boiler-oxp3-fingerprint.rules
    status: external_runtime_required
    notes: "Default enabled for the confirmed BF63112 module; preserve user disable and Steam PIN fallback. Source: FlightDan/FingerprintUnlock-SteamOS@fde8fa62bbad0318a9a8be88cc77bb4c3b4f919e; public lock: common/fingerprint/public-bridge-lock.json."
  - id: slot-switch
    name: KDE 槽位切换 / 系统回退
    recommendation: optional
    default: false
    dependencies: []
    sources[3]: common/scripts/slot_switch.py,common/scripts/slot-switch/boot.py,common/scripts/slot-switch/desktop.py
    status: source_reference_only
    notes: A/B 布局及系统工具满足时可选；真实切换与重启分别验证。
  - id: partition-mount
    name: KDE 图形分区持久挂载
    recommendation: optional
    default: false
    dependencies: []
    sources[3]: common/scripts/partition_mount.py,common/scripts/shared_storage.py,common/scripts/ntfs_steam.py
    status: source_reference_only
    notes: 共享 home/NTFS 布局核对后可选；本次归档基线不代表工作区后续 NTFS 修复。
  - id: refind
    name: rEFInd · 双系统图形启动菜单
    recommendation: optional
    default: false
    dependencies: []
    sources: []
    status: source_reference_only
    notes: 独立启动管理器入口；脚本不归机型适配所有，核对 EFI 与双系统布局。
  - id: opti2xmx
    name: Opti2XMX · 每游戏 XMX / Opti 注入与版本管理
    recommendation: optional
    default: false
    dependencies[1]: decky
    sources: []
    status: source_reference_only
    notes: 使用独立公开插件与运行库；需要受支持 Intel GPU，逐游戏验证。
  - id: gamescope-env
    name: 游戏模式启动环境隔离 · 修复桌面切回黑屏
    recommendation: optional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: source_reference_only
    notes: 仅用于已确认的游戏模式环境问题；保留原环境恢复。
  - id: flathub-ustc
    name: SteamOS 桌面模式 应用商店 · 中科大 Flathub 源（可选）
    recommendation: optional
    default: false
    dependencies: []
    sources[2]: brands/onexplayer/oxp3/scripts/integration.py,brands/onexplayer/oxp3/scripts/flathub.flatpakrepo
    status: source_reference_only
    notes: 用户主动选择；保留原 remote，当前归档不补写尚未接入的换源流程。
  - id: hdr
    name: 游戏模式 HDR · Gamma 2.2
    recommendation: optional
    default: false
    dependencies: []
    sources[3]: brands/onexplayer/oxp3/scripts/hdr/installer.py,brands/onexplayer/oxp3/scripts/hdr/generate.py,brands/onexplayer/oxp3/scripts/hdr/profile.json
    status: source_reference_only
    notes: OXP3 专用 472/1100 配置，精确面板及 Gamescope 3.16.30-1；不能套用 X2 参数。
  - id: desktop-hdr
    name: KDE 桌面 HDR（OXP3 472/1100）
    recommendation: optional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: external_runtime_required
    notes: OXP3 传统桌面映射需固定 KWin/ABI 和完整原生运行时；X2mini 的安全试用入口按机型检查跳过，不作为 OXP3 功能。
  - id: keyboard
    name: KDE 屏幕键盘配置
    recommendation: optional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: source_reference_only
    notes: 按 KDE 会话与目标软件检查；验证实际输入及恢复。
  - id: input
    name: 背键驱动 · M1/L4、M2/R4、Home/L5
    recommendation: recommended
    default: false
    dependencies: []
    sources[3]: brands/onexplayer/common/scripts/input_profile.py,brands/onexplayer/common/scripts/input-profile.yaml,brands/onexplayer/common/scripts/input-profile.conf
    status: source_reference_only
    notes: "核对唯一 1a86:fe00 MCU 接口 02；另需原公开 hid-oxp 模块和 capability map。"
  - id: multifunction
    name: 多功能键映射为 R5
    recommendation: recommended
    default: false
    dependencies[1]: input
    sources[1]: brands/onexplayer/common/scripts/input-profile.yaml
    status: source_reference_only
    notes: 沿用现有按键模板；逐键验证实体键位。
  - id: gyro
    name: BMI260 陀螺仪（新装需校准）
    recommendation: recommended
    default: false
    dependencies[1]: input
    sources[1]: brands/onexplayer/oxp3/common-device-sources.toon
    status: source_reference_only
    notes: "Source reference only; verify BMI260 identity, kernel and InputPlumber compatibility before installation or calibration."
  - id: xe-dsb
    name: OXP3 显示兼容修复 · 暂停 DSB
    recommendation: conditional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: source_reference_only
    notes: 仅 OXP3 对应显示问题；保留现有精确系统/内核限制。
  - id: gm7-resume
    name: GM7 休眠恢复 · 自动匹配目标 SSD
    recommendation: conditional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/common-device-sources.toon
    status: source_reference_only
    notes: Apply only after matching the target SSD identity; verify installation and recovery.
  - id: split-lock
    name: Split-lock 报告洪泛修复 · 需要重启
    recommendation: conditional
    default: false
    dependencies: []
    sources[1]: common/scripts/split_lock.py
    status: source_reference_only
    notes: 确认存在报告洪泛且启动文件受支持时使用；重启生效，按原事务恢复。
  - id: wifi
    name: BE201 无线 c106 与蓝牙固件
    recommendation: conditional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/common-device-sources.toon
    status: source_reference_only
    notes: Source reference only; verify the actual wireless device and firmware compatibility.
  - id: manager
    name: SteamOS Manager 状态与错误修复
    recommendation: recommended
    default: false
    dependencies: []
    sources[2]: brands/onexplayer/oxp3/scripts/integration.py,brands/onexplayer/oxp3/scripts/controls/compatibility.py
    status: source_reference_only
    notes: 核对实际 Manager 接口和软件版本；不取消已有硬件检查。
  - id: native-tdp
    name: 原生 TDP 10–40W 控制
    recommendation: conditional
    default: false
    dependencies[1]: manager
    sources[1]: brands/onexplayer/oxp3/scripts/controls/rapl/provider.py
    status: source_reference_only
    notes: 仅保留已公开常规 RAPL 实现；10–40W 不作为其他机型范围。
  - id: overlay
    name: CPU/GPU/APU 功耗与 PVRAM 叠加层
    recommendation: optional
    default: false
    dependencies: []
    sources[2]: brands/onexplayer/oxp3/scripts/controls/overlay/telemetry.py,brands/onexplayer/oxp3/scripts/controls/overlay/allow-read.py
    status: source_reference_only
    notes: 按实际 CPU/GPU 接口验证读数，缺失指标保持缺失。
  - id: fan-driver
    name: OXP3 风扇与充电接口驱动
    recommendation: conditional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: source_reference_only
    notes: OXP3 专用寄存器/驱动布局；另需匹配公开驱动载荷。
  - id: oxp3-fan
    name: OXP3 风扇 · 自动与曲线
    recommendation: optional
    default: false
    dependencies[2]: fan-driver,decky
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: source_reference_only
    notes: OXP3 专用风扇界面与曲线；另需原公开插件载荷。
  - id: oxp3-cpu
    name: OXP3 CPU · EPP 与分组限频
    recommendation: optional
    default: false
    dependencies[1]: decky
    sources[2]: brands/onexplayer/oxp3/scripts/controls/cpu/cpu_control.py,brands/onexplayer/oxp3/scripts/controls/cpu/power_control.py
    status: source_reference_only
    notes: 仅保留公开常规控制；未纳入工作区新动态功耗研究。
  - id: charging
    name: OXP3 Battery · 充电上限与模式
    recommendation: optional
    default: false
    dependencies[2]: fan-driver,decky
    sources[1]: brands/onexplayer/oxp3/scripts/integration.py
    status: source_reference_only
    notes: OXP3 专用电池/充电接口；另需原公开插件载荷。
  - id: oxp3-light
    name: OXP3 Light · 三分区灯光控制
    recommendation: optional
    default: false
    dependencies[1]: decky
    sources[2]: brands/onexplayer/oxp3/scripts/light/main.py,brands/onexplayer/oxp3/scripts/light/light_control.py
    status: source_reference_only
    notes: 核对现有 HID 报文格式；保留上游许可证和恢复行为。
  - id: legacy-runtime
    name: 音量键与电量显示修复
    recommendation: optional
    default: false
    dependencies: []
    sources[1]: brands/onexplayer/oxp3/scripts/integration_runtime.py
    status: source_reference_only
    notes: 保留原音量/电量运行时依赖，不自动迁移到其他机型。
  - id: windows-reboot
    name: 重启进入 Windows · Decky 按钮与桌面快捷方式
    recommendation: optional
    default: false
    dependencies[1]: decky
    sources[2]: common/scripts/windows_reboot.py,common/scripts/windows-reboot/boot.py
    status: source_reference_only
    notes: 核对 Windows EFI 启动项、授权入口及恢复。
  - id: decky
    name: Decky Loader · 插件运行环境
    recommendation: optional
    default: false
    dependencies: []
    sources[2]: brands/onexplayer/oxp3/scripts/plugin_installer.py,brands/onexplayer/oxp3/scripts/decky_order.py
    status: source_reference_only
    notes: 使用 Boiler 通用部署入口；依赖插件选中时一起选择。
  - id: waydroid
    name: Waydroid r2 · Android 宿主适配
    recommendation: optional
    default: false
    dependencies: []
    sources[2]: brands/onexplayer/oxp3/scripts/waydroid_setup.py,brands/onexplayer/oxp3/scripts/waydroid/compatibility.py
    status: source_reference_only
    notes: 可选；另需公开 r2 资源，核对内核与 Android 容器条件。
