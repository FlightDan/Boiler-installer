{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boiler.local/schemas/definitions.json",
  "$defs": {
    "id": {"type":"string","pattern":"^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_.-]*$"},
    "version": {"type":"string","pattern":"^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.+-]+)?$"},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "path": {"type":"string","minLength":1,"pattern":"^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f]+$"},
    "compatibility": {
      "type":"object","additionalProperties":false,
      "properties": {
        "architectures":{"$ref":"#/$defs/stringList"},"os_ids":{"$ref":"#/$defs/stringList"},
        "device_ids":{"$ref":"#/$defs/stringList"},"os_versions":{"$ref":"#/$defs/stringList"},"kernels":{"$ref":"#/$defs/stringList"}
      }
    },
    "stringList":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "source": {
      "type":"object","required":["kind"],
      "oneOf":[
        {"properties":{"kind":{"const":"github"},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}},"required":["repository","commit"]},
        {"properties":{"kind":{"const":"local"},"path":{"type":"string","minLength":1},"repository":{"type":"string","minLength":1},"base_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}},"anyOf":[{"required":["path"]},{"required":["repository"]}]},
        {"properties":{"kind":{"const":"https"},"url":{"type":"string","pattern":"^https://"},"sha256":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":0}},"required":["url","sha256","size"]}
      ]
    },
    "file": {
      "type":"object","required":["source","target","sha256","size"],
      "properties":{"source":{"$ref":"#/$defs/path"},"target":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":0,"maximum":137438953472},"mode":{"type":"integer","minimum":0,"maximum":511}}
    },
    "inventoryFile": {
      "type":"object","required":["path","sha256","size"],
      "properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":0,"maximum":137438953472}}
    }
  }
}
