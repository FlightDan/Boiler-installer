{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boiler ComponentManifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "ComponentManifest"
    },
    "id": {
      "$ref": "definitions.json#/$defs/id"
    },
    "version": {
      "$ref": "definitions.json#/$defs/version"
    },
    "minimum_engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compatibility": {
      "$ref": "definitions.json#/$defs/compatibility"
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.json#/$defs/id"
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.json#/$defs/id"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "definitions.json#/$defs/file"
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apply": {
          "type": "string",
          "pattern": "^scripts/.+\\.sh$"
        },
        "verify": {
          "type": "string",
          "pattern": "^scripts/.+\\.sh$"
        },
        "restore": {
          "type": "string",
          "pattern": "^scripts/.+\\.sh$"
        }
      }
    },
    "ssd_boot_policy": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "ssd:gm7-boot-repair"},
        "version": {"type": "integer", "const": 1}
      }
    },
    "retain_owned_paths": {
      "type": "boolean",
      "default": false,
      "description": "Upgrade only: retain verified omitted paths already owned by this exact component; static files only."
    }
  },
  "allOf": [
    {
      "if": {"required": ["ssd_boot_policy"]},
      "then": {"required": ["minimum_engine_version", "optional"], "not": {"required": ["dynamic_handler"]}, "properties": {"optional": {"const": true}, "files": {"maxItems": 0}, "requires": {"maxItems": 0}, "conflicts": {"maxItems": 0}, "hooks": {"maxProperties": 0}, "compatibility": {"maxProperties": 0}, "retain_owned_paths": {"const": false}}}
    },
    {
      "if": {
        "properties": {
          "retain_owned_paths": {
            "const": true
          }
        },
        "required": [
          "retain_owned_paths"
        ]
      },
      "then": {
        "properties": {
          "hooks": {
            "maxProperties": 0
          },
          "files": {
            "minItems": 1
          }
        },
        "required": [
          "files"
        ]
      }
    }
  ]
}
