{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Boiler DevicePackage v1","type":"object",
  "required":["schema_version","kind","id","version","source","components","files"],
  "properties":{
    "schema_version":{"const":1},"kind":{"const":"DevicePackage"},
    "id":{"$ref":"definitions.json#/$defs/id"},"version":{"$ref":"definitions.json#/$defs/version"},
    "source":{"$ref":"definitions.json#/$defs/source"},"compatibility":{"$ref":"definitions.json#/$defs/compatibility"},
    "minimum_engine_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "oxp3_efi_contract":{"type":"object","required":["kind","component"],"additionalProperties":false,
      "properties":{"kind":{"const":"oxp3-split-lock-efi-v1"},"component":{"const":"oxp3:legacy-adaptation"}}},
    "x2_efi_contract":{"type":"object","required":["kind","component"],"additionalProperties":false,
      "properties":{"kind":{"const":"x2-split-lock-efi-v1"},"component":{"const":"oxp3:legacy-adaptation"}}},
    "oxp3_full_efi_contract":{"type":"object","required":["kind","component"],"additionalProperties":false,
      "properties":{"kind":{"const":"oxp3-full-split-lock-efi-v1"},"component":{"const":"oxp3:legacy-adaptation"}}},
    "maintenance_entry":{
      "description":"Engine-managed hook lifecycle declaration. Legacy script paths are readable metadata but cannot enable generic scripted updates.",
      "oneOf":[
        {"type":"object","required":["kind"],"additionalProperties":false,"properties":{"kind":{"const":"engine-hooks-v1"}}},
        {"allOf":[{"$ref":"definitions.json#/$defs/path"},{"type":"string","pattern":"^scripts/.+\\.sh$"}]}
      ]
    },
    "components":{"type":"array","items":{"$ref":"ComponentManifest.schema.json"}},
    "files":{"type":"array","items":{"$ref":"definitions.json#/$defs/inventoryFile"}}
  },
  "allOf":[{
    "if":{"properties":{"components":{"contains":{"required":["ssd_boot_policy"]}}},"required":["components"]},
    "then":{"required":["minimum_engine_version"]}
  }]
}
